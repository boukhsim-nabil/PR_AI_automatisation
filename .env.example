POSTGRES_DB=automation
POSTGRES_USER=automation
POSTGRES_PASSWORD=automation_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://automation:automation_dev_password@127.0.0.1:5432/automation
TEST_DATABASE_URL=postgresql+psycopg://automation_test:automation_test_password@127.0.0.1:55432/automation_test
APP_ENV=development
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=automation-api
JWT_AUDIENCE=automation-frontend
SEED_USER_EMAIL=admin@acme.com
SEED_USER_PASSWORD=replace-with-a-local-seed-password
